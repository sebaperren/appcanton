rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla para la colección de proveedores y artículos de la App Cantón
    match /suppliers/{docId} {
      allow read, write: if request.auth != null;
    }

    // 1. Colecciones permitidas para usuarios autenticados
    match /pipeline_ia/{docId} {
      allow read, write: if request.auth != null;
      match /notes/{noteId} {
        allow read, write: if request.auth != null;
      }
      match /historial/{histId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /bot_log/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /bancos_habilitados/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /usuarios/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && hasRole(request.auth.uid, 'admin');
      allow update: if request.auth != null && (
        hasRole(request.auth.uid, 'admin') || 
        (request.auth.uid == docId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role', 'permisos']))
      );
    }
    
    match /recordatorios/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /ofertas_comerciales/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /campanas/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /promociones_bancarias/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /tarjetas_habilitadas/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /formas_pago_efectivo/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /formas_pago_cheques/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /historial_cambios/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /presupuestos_destacados/{docId} {
      allow read, write: if request.auth != null;
    }

    match /configuracion_oportunidades_ia/{docId} {
      allow read, write: if request.auth != null;
    }

    match /presupuestos_competencia/{docId} {
      allow read, write: if request.auth != null;
    }

    match /objetivos/{docId} {
      allow read, write: if request.auth != null;
    }

    match /analytics_cache/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // 2. Reglas específicas para configuracion_global
    match /configuracion_global/settings {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN', 'MANAGER'];
    }
    
    match /configuracion_global/normalizacion_direcciones_progreso {
      allow read, write: if request.auth != null;
    }
    
    // Funciones auxiliares para verificar roles
    function getRole(userId) {
      return get(/databases/$(database)/documents/usuarios/$(userId)).data.rol;
    }
    
    function hasRole(userId, role) {
      let r = getRole(userId);
      return r == role || 
             (role == 'admin' && (r == 'ADMIN' || r == 'SUPER_ADMIN')) ||
             (role == 'gerente' && (r == 'MANAGER' || r == 'BRANCH_MANAGER' || r == 'ADMIN' || r == 'SUPER_ADMIN'));
    }
    
    // Reglas para la unificación de mensajes
    match /mensajes_unificados/{messageId} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth == null; // Cloud Function lo escribe
      allow update: if request.auth.uid != null && 
                   (resource.data.asignado_a == request.auth.uid || 
                    hasRole(request.auth.uid, 'admin'));
    }
    
    // 3. Bloqueo por defecto para cualquier otra colección
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
